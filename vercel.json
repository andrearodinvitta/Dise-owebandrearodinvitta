{
  "version": 2,
  "name": "andrea-rodriguez-design",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/portafolio/celebraciones/boda-marta-jeronimo", "destination": "/portafolio/celebraciones/bodamartayjeronimo/index.html" },
    { "source": "/portafolio/celebraciones/boda-valentina-mateo", "destination": "/portafolio/celebraciones/bodavalentinaymateo/index.html" },
    { "source": "/portafolio/celebraciones/luciana-xv", "destination": "/portafolio/celebraciones/lucianavillarreal/index.html" },
    { "source": "/portafolio/celebraciones/lucianaxv", "destination": "/portafolio/celebraciones/lucianavillarreal/index.html" },
    { "source": "/portafolio/comercio/dumore-chocolate", "destination": "/portafolio/comercio/dumorechocolate/index.html" },
    { "source": "/portafolio/comercio/dumore", "destination": "/portafolio/comercio/dumorechocolate/index.html" },
    { "source": "/portafolio/comercio/zafiro-travel", "destination": "/portafolio/comercio/zafirotravel/index.html" },
    { "source": "/portafolio/comercio/soraya-nails", "destination": "/portafolio/comercio/sorayanails/index.html" }
  ]
}
